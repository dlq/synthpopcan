{
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.12",
  "typeCheckingMode": "standard",
  "strict": [
    "src/synthpopcan/__init__.py",
    "src/synthpopcan/_interface.py",
    "src/synthpopcan/_runtime_schemas.py",
    "src/synthpopcan/benchmarks.py",
    "src/synthpopcan/cli_exchange.py",
    "src/synthpopcan/cli_microdata.py",
    "src/synthpopcan/console.py",
    "src/synthpopcan/contracts/__init__.py",
    "src/synthpopcan/ipf.py",
    "src/synthpopcan/national_da.py",
    "src/synthpopcan/tabular.py",
    "src/synthpopcan/tree_benchmark.py",
    "src/synthpopcan/validation.py",
    "src/synthpopcan/web/__init__.py",
    "src/synthpopcan/webapp.py",
    "src/synthpopcan/workflows/__init__.py",
    "src/synthpopcan/workflows/ipf.py",
    "src/synthpopcan/workflows/small_area.py",
    "src/synthpopcan/workflows/types.py"
  ],
  "reportMissingModuleSource": "none",
  "extraPaths": ["src"],
  "exclude": [
    "tests",
    "scripts",
    "docs",
    "**/.venv",
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "node_modules",
    "dist"
  ]
}
